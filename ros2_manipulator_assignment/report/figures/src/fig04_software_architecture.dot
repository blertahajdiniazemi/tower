// Figure: software architecture of the delivered manipulator visualisation
// Solid = started by display.launch.py; dashed grey = optional / not part of the verified core.
digraph arch {
  graph [rankdir=TB, fontname="Liberation Sans", fontsize=15, nodesep=0.25, ranksep=0.42, pad=0.1, newrank=true];
  node  [fontname="Liberation Sans", fontsize=16, shape=box, style="rounded,filled", color="#1f3b5a", fillcolor="#dbe7f3", penwidth=1.3];
  edge  [fontname="Liberation Sans", fontsize=14, color="#1f3b5a", penwidth=1.3];

  xacro_file [shape=note, fillcolor="#f2f2f2", label=<<b>arduinobot.urdf.xacro</b><br/><font point-size="14">links, joints, mesh URIs</font>>];
  xacro_cmd [shape=component, fillcolor="#f2f2f2", label=<<b>xacro</b><br/><font point-size="14">Command() in launch file</font>>];
  rsp [label=<<b>robot_state_publisher</b>>];
  jsp [label=<<b>joint_state_publisher_gui</b><br/><font point-size="14">or joint_state_publisher (gui:=false)</font>>];
  t_rd [style="filled", fillcolor="#f6e3cf", color="#b5651d", label=<<b>/robot_description</b><br/><font point-size="14">String, transient local</font>>];
  t_js [style="filled", fillcolor="#f6e3cf", color="#b5651d", label=<<b>/joint_states</b><br/><font point-size="14">JointState</font>>];
  t_tf [style="filled", fillcolor="#f6e3cf", color="#b5651d", label=<<b>/tf</b><br/><font point-size="14">movable joints</font>>];
  t_tfs [style="filled", fillcolor="#f6e3cf", color="#b5651d", label=<<b>/tf_static</b><br/><font point-size="14">fixed joints</font>>];
  rviz [label=<<b>rviz2</b><br/><font point-size="14">display.rviz · fixed frame base_link</font>>];
  meshes [shape=folder, fillcolor="#f2f2f2", label=<<b>meshes/*.STL</b>>];
  opt [style="rounded,filled,dashed", color="#9a9a9a", fillcolor="#f7f7f7", fontcolor="#555555",
       label=<<b>Optional, not verified here</b><br/><font point-size="14">gazebo.launch.py (ros_gz); later sections:<br/>ros2_control, MoveIt 2, firmware, Alexa</font>>];

  {rank=same; xacro_file; xacro_cmd}
  {rank=same; rsp; jsp}
  {rank=same; t_js; t_rd; t_tf; t_tfs}
  {rank=same; meshes; rviz; opt}

  xacro_file -> xacro_cmd [label=" path "];
  xacro_cmd -> rsp [label=" URDF string "];
  rsp -> t_rd; rsp -> t_tf; rsp -> t_tfs;
  t_rd -> jsp;
  jsp -> t_js;
  t_js -> rsp [constraint=false, label=" subscribe "];
  t_rd -> rviz; t_tf -> rviz; t_tfs -> rviz;
  meshes -> rviz [style=dashed, label=" package:// "];
  rviz -> opt [style=invis];
}
